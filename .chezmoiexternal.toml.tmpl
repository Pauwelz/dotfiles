{{ if .desktop -}}
[".local/share/fonts/FiraCodeNerdFont"]
    type = "archive"
    url = "https://github.com/ryanoasis/nerd-fonts/releases/download/{{ .fonts.nerd_fonts_version }}/FiraCode.zip"
    include = ["*.ttf"]
    refreshPeriod = "168h"

{{- /* GNOME Shell extensions, pinned in .chezmoidata/packages.yaml (gnome_extensions.*).
       Unpacking the release zip is all `gnome-extensions install` does; the dconf
       template enables them. exact drops files left over from an older release. */}}

[".local/share/gnome-shell/extensions/dash-to-panel@jderose9.github.com"]
    type = "archive"
    url = "https://github.com/home-sweet-gnome/dash-to-panel/releases/download/{{ .gnome_extensions.dash_to_panel }}/dash-to-panel%40jderose9.github.com_{{ .gnome_extensions.dash_to_panel }}.zip"
    exact = true
    refreshPeriod = "168h"

[".local/share/gnome-shell/extensions/tailscale-gnome-qs@tailscale-qs.github.io"]
    type = "archive"
    url = "https://github.com/tailscale-qs/tailscale-gnome-qs/releases/download/{{ .gnome_extensions.tailscale_qs }}/tailscale-gnome-qs%40tailscale-qs.github.io.zip"
    exact = true
    refreshPeriod = "168h"

{{- /* Just the Browser policy for Chrome, copied into /etc by run_after_45. Tracks
       the upstream main branch, so a change there lands at the next refresh. */}}

[".local/share/just-the-browser/chrome-managed_policies.json"]
    type = "file"
    url = "https://raw.githubusercontent.com/corbindavenport/just-the-browser/main/chrome/managed_policies.json"
    refreshPeriod = "168h"
{{ end -}}
{{ if .devtools -}}
{{- /* Release binaries pinned in .chezmoidata/packages.yaml (tools.*). Some projects
       name assets amd64/arm64, others x86_64/arm64. */ -}}
{{- $arch := .chezmoi.arch -}}
{{- $archAlt := ternary "x86_64" "arm64" (eq $arch "amd64") -}}

[".local/bin/kubectl"]
    type = "file"
    url = "https://dl.k8s.io/release/{{ .tools.kubectl }}/bin/linux/{{ $arch }}/kubectl"
    executable = true
    refreshPeriod = "168h"

[".local/bin/helm"]
    type = "archive-file"
    url = "https://get.helm.sh/helm-{{ .tools.helm }}-linux-{{ $arch }}.tar.gz"
    path = "linux-{{ $arch }}/helm"
    executable = true
    refreshPeriod = "168h"

[".local/bin/k9s"]
    type = "archive-file"
    url = "https://github.com/derailed/k9s/releases/download/{{ .tools.k9s }}/k9s_Linux_{{ $arch }}.tar.gz"
    path = "k9s"
    executable = true
    refreshPeriod = "168h"

[".local/bin/kubectx"]
    type = "archive-file"
    url = "https://github.com/ahmetb/kubectx/releases/download/{{ .tools.kubectx }}/kubectx_{{ .tools.kubectx }}_linux_{{ $archAlt }}.tar.gz"
    path = "kubectx"
    executable = true
    refreshPeriod = "168h"

[".local/bin/kubens"]
    type = "archive-file"
    url = "https://github.com/ahmetb/kubectx/releases/download/{{ .tools.kubectx }}/kubens_{{ .tools.kubectx }}_linux_{{ $archAlt }}.tar.gz"
    path = "kubens"
    executable = true
    refreshPeriod = "168h"

[".local/bin/k3d"]
    type = "file"
    url = "https://github.com/k3d-io/k3d/releases/download/{{ .tools.k3d }}/k3d-linux-{{ $arch }}"
    executable = true
    refreshPeriod = "168h"

[".local/bin/tilt"]
    type = "archive-file"
    url = "https://github.com/tilt-dev/tilt/releases/download/v{{ .tools.tilt }}/tilt.{{ .tools.tilt }}.linux.{{ $archAlt }}.tar.gz"
    path = "tilt"
    executable = true
    refreshPeriod = "168h"
{{ end -}}
