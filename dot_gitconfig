[user]
	name = Michel Pauwels
	# No global email on purpose: it is chosen per remote host below.
	# Repos matching neither host must set user.email locally.
	# Note: SCP-style remotes (git@host:path) are not matched by hasconfig on
	# git 2.43; use https:// or ssh:// remotes.

[includeIf "hasconfig:remote.*.url:https://github.com/**"]
	path = ~/.config/git/github.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:**"]
	path = ~/.config/git/github.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/**"]
	path = ~/.config/git/github.gitconfig

[includeIf "hasconfig:remote.*.url:https://*dev.azure.com/**"]
	path = ~/.config/git/devops.gitconfig
[includeIf "hasconfig:remote.*.url:git@ssh.dev.azure.com:**"]
	path = ~/.config/git/devops.gitconfig
[includeIf "hasconfig:remote.*.url:https://*.visualstudio.com/**"]
	path = ~/.config/git/devops.gitconfig
