{{- /* Answered once on `chezmoi init`; re-ask with `chezmoi init --prompt`.
       Keep commas out of the prompt texts: `--promptBool` splits on them. */ -}}
{{- $desktop := promptBoolOnce . "desktop" "Is this a GNOME desktop (install GUI apps and fonts and apply dconf settings)" -}}
{{- $devtools := promptBoolOnce . "devtools" "Is this a development machine (install Docker plus .NET/Kubernetes/Azure tooling and create a k3d cluster)" -}}
{{- $workEmail := promptStringOnce . "workEmail" "Work email (used for Azure DevOps repos)" -}}
{{- /* Laptops get a few extras on top of the desktop set (Gaze face unlock, Teams).
       Detected from the SMBIOS chassis type instead of a prompt; re-evaluated on
       every `chezmoi init`. 8 Portable, 9 Laptop, 10 Notebook, 14 Sub Notebook,
       31 Convertible, 32 Detachable. Servers, VMs and WSL report something else
       or have no DMI at all. */ -}}
{{- $chassis := "" -}}
{{- if stat "/sys/class/dmi/id/chassis_type" -}}
{{-   $chassis = output "cat" "/sys/class/dmi/id/chassis_type" | trim -}}
{{- end -}}
{{- $laptop := and $desktop (has $chassis (list "8" "9" "10" "14" "31" "32")) -}}
[data]
    desktop = {{ $desktop }}
    devtools = {{ $devtools }}
    laptop = {{ $laptop }}
    workEmail = {{ $workEmail | quote }}

# Installs and logs in to the Bitwarden CLI before chezmoi reads the source
# state, so the SSH-key script can list the vault. See
# https://www.chezmoi.io/user-guide/advanced/install-your-password-manager-on-init/
[hooks.read-source-state.pre]
    command = {{ joinPath .chezmoi.sourceDir ".install-password-manager.sh" | quote }}
